{
  "type": "APL",
  "version": "2024.1",
  "theme": "light",
  "import": [
    { "name": "alexa-layouts", "version": "1.7.0" },
    { "name": "alexa-styles", "version": "1.6.0" }
  ],
  "handleTick": [
    {
      "minimumDelay": 15000,
      "commands": [
        {
          "type": "SendEvent",
          "sequencer": "keepAlive",
          "arguments": ["PING"]
        }
      ]
    }
  ],
  "mainTemplate": {
    "parameters": ["myPrayerTimeData"],
    "item": {
      "type": "Frame",
      "width": "100vw",
      "height": "100vh",
      "backgroundColor": "#FDF5E6",
      "item": {
        "type": "Container",
        "width": "100vw",
        "height": "100vh",
        "items": [
          {
            "type": "Video",
            "position": "absolute",
            "width": 1,
            "height": 1,
            "top": -100,
            "left": -100,
            "source": [
              {
                "url": "https://my-prayer-time-content-357977905088.s3.us-east-1.amazonaws.com/audio/noop.mp4",
                "repeatCount": -1
              }
            ],
            "autoplay": true
          },
          {
            "type": "Container",
            "position": "absolute",
            "left": "0",
            "top": "0",
            "width": "100vw",
            "height": "100vh",
            "direction": "column",
            "paddingLeft": "3vw",
            "paddingRight": "3vw",
            "paddingTop": "1.5vh",
            "paddingBottom": "1.5vh",
            "items": [

              {
                "type": "Container",
                "direction": "row",
                "justifyContent": "spaceBetween",
                "alignItems": "center",
                "width": "100%",
                "height": "7vh",
                "items": [
                  {
                    "type": "Container",
                    "direction": "row",
                    "alignItems": "center",
                    "items": [
                      {
                        "type": "Text",
                        "text": "☪",
                        "fontSize": "38.5dp",
                        "color": "#0D7039"
                      },
                      {
                        "type": "Text",
                        "text": " My Prayer Time",
                        "fontSize": "40.5dp",
                        "fontWeight": "700",
                        "color": "#0D7039",
                        "letterSpacing": "1dp"
                      }
                    ]
                  },
                  {
                    "type": "Container",
                    "direction": "column",
                    "alignItems": "end",
                    "items": [
                      {
                        "type": "Container",
                        "direction": "row",
                        "alignItems": "center",
                        "items": [
                          {
                            "type": "Text",
                            "text": "${myPrayerTimeData.properties.moonPhase}",
                            "fontSize": "32.5dp"
                          },
                          {
                            "type": "Text",
                            "text": " ${myPrayerTimeData.properties.hijriDateEn}",
                            "fontSize": "26.5dp",
                            "fontWeight": "600",
                            "color": "#95773E"
                          }
                        ]
                      },
                      {
                        "type": "Text",
                        "text": "${myPrayerTimeData.properties.cityName} · ${myPrayerTimeData.properties.madhab}",
                        "fontSize": "19.5dp",
                        "color": "#50575C"
                      }
                    ]
                  }
                ]
              },

              {
                "type": "Frame",
                "width": "100%",
                "height": "2dp",
                "backgroundColor": "#0D7039"
              },

              {
                "type": "Container",
                "when": "${myPrayerTimeData.properties.isRamadan}",
                "direction": "column",
                "alignItems": "center",
                "width": "100%",
                "spacing": "12.5dp",
                "items": [
                  {
                    "type": "Frame",
                    "borderRadius": "20dp",
                    "backgroundColor": "rgba(13,112,57,0.1)",
                    "borderWidth": "1",
                    "borderColor": "rgba(13,112,57,0.3)",
                    "paddingLeft": "20dp",
                    "paddingRight": "20dp",
                    "paddingTop": "4dp",
                    "paddingBottom": "4dp",
                    "item": {
                      "type": "Container",
                      "direction": "row",
                      "alignItems": "center",
                      "items": [
                        {
                          "type": "Text",
                          "text": "🌙 ${myPrayerTimeData.properties.ramadanText}",
                          "fontSize": "19.5dp",
                          "fontWeight": "700",
                          "color": "#0D7039"
                        },
                        {
                          "type": "Text",
                          "text": "  ·  ${myPrayerTimeData.properties.eidCountdown} (${myPrayerTimeData.properties.eidEstDate})",
                          "fontSize": "19.5dp",
                          "color": "#50575C"
                        }
                      ]
                    }
                  },

                  {
                    "type": "Frame",
                    "when": "${myPrayerTimeData.properties.suhoor.showBanner}",
                    "borderRadius": "16dp",
                    "backgroundColor": "${myPrayerTimeData.properties.suhoor.urgency == 'urgent' ? 'rgba(219,101,94,0.15)' : myPrayerTimeData.properties.suhoor.urgency == 'warning' ? 'rgba(216,182,95,0.2)' : 'rgba(13,112,57,0.1)'}",
                    "borderWidth": "2",
                    "borderColor": "${myPrayerTimeData.properties.suhoor.urgency == 'urgent' ? '#DB655E' : myPrayerTimeData.properties.suhoor.urgency == 'warning' ? '#D8B65F' : '#0D7039'}",
                    "paddingLeft": "16dp",
                    "paddingRight": "16dp",
                    "paddingTop": "4dp",
                    "paddingBottom": "4dp",
                    "item": {
                      "type": "Container",
                      "direction": "row",
                      "alignItems": "center",
                      "items": [
                        {
                          "type": "Text",
                          "text": "🌙 Suhoor ends in ${myPrayerTimeData.properties.suhoor.countdown}",
                          "fontSize": "19.5dp",
                          "fontWeight": "700",
                          "color": "${myPrayerTimeData.properties.suhoor.urgency == 'urgent' ? '#DB655E' : '#24332A'}"
                        },
                        {
                          "type": "Text",
                          "text": "  ·  Fajr at ${myPrayerTimeData.properties.suhoor.endTime12hr}",
                          "fontSize": "19.5dp",
                          "color": "#50575C"
                        }
                      ]
                    }
                  },

                  {
                    "type": "Frame",
                    "when": "${myPrayerTimeData.properties.iftar.showBanner}",
                    "borderRadius": "16dp",
                    "backgroundColor": "${myPrayerTimeData.properties.iftar.urgency == 'urgent' ? 'rgba(219,101,94,0.15)' : myPrayerTimeData.properties.iftar.urgency == 'warning' ? 'rgba(216,182,95,0.2)' : 'rgba(13,112,57,0.1)'}",
                    "borderWidth": "2",
                    "borderColor": "${myPrayerTimeData.properties.iftar.urgency == 'urgent' ? '#DB655E' : myPrayerTimeData.properties.iftar.urgency == 'warning' ? '#D8B65F' : '#0D7039'}",
                    "paddingLeft": "16dp",
                    "paddingRight": "16dp",
                    "paddingTop": "4dp",
                    "paddingBottom": "4dp",
                    "item": {
                      "type": "Container",
                      "direction": "row",
                      "alignItems": "center",
                      "items": [
                        {
                          "type": "Text",
                          "text": "🍽️ Iftar in ${myPrayerTimeData.properties.iftar.countdown}",
                          "fontSize": "19.5dp",
                          "fontWeight": "700",
                          "color": "${myPrayerTimeData.properties.iftar.urgency == 'urgent' ? '#DB655E' : '#24332A'}"
                        },
                        {
                          "type": "Text",
                          "text": "  ·  Maghrib at ${myPrayerTimeData.properties.iftar.time12hr}",
                          "fontSize": "19.5dp",
                          "color": "#50575C"
                        },
                        {
                          "type": "Text",
                          "when": "${myPrayerTimeData.properties.iftar.showDua && myPrayerTimeData.properties.iftar.dua}",
                          "text": "  ·  ${myPrayerTimeData.properties.iftar.dua.arabic}",
                          "fontSize": "19.5dp",
                          "fontWeight": "600",
                          "color": "#95773E"
                        }
                      ]
                    }
                  },

                  {
                    "type": "Frame",
                    "when": "${myPrayerTimeData.properties.lastTenNights.isActive}",
                    "borderRadius": "16dp",
                    "backgroundColor": "rgba(216,182,95,0.2)",
                    "borderWidth": "${myPrayerTimeData.properties.lastTenNights.isOddNight ? '3' : '2'}",
                    "borderColor": "#D8B65F",
                    "paddingLeft": "16dp",
                    "paddingRight": "16dp",
                    "paddingTop": "4dp",
                    "paddingBottom": "4dp",
                    "item": {
                      "type": "Container",
                      "direction": "row",
                      "alignItems": "center",
                      "items": [
                        {
                          "type": "Text",
                          "text": "✨ Night ${myPrayerTimeData.properties.lastTenNights.nightNumber} of Last 10",
                          "fontSize": "19.5dp",
                          "fontWeight": "700",
                          "color": "#95773E"
                        },
                        {
                          "type": "Text",
                          "when": "${myPrayerTimeData.properties.lastTenNights.isOddNight}",
                          "text": "  ·  Seek Laylat al-Qadr!",
                          "fontSize": "19.5dp",
                          "fontWeight": "600",
                          "color": "#95773E"
                        },
                        {
                          "type": "Text",
                          "when": "${myPrayerTimeData.properties.lastTenNights.dua}",
                          "text": "  ${myPrayerTimeData.properties.lastTenNights.dua.arabic}",
                          "fontSize": "19.5dp",
                          "color": "#50575C"
                        }
                      ]
                    }
                  },

                  {
                    "type": "Text",
                    "when": "${myPrayerTimeData.properties.zakat.show}",
                    "text": "💰 ${myPrayerTimeData.properties.zakat.messageEn}",
                    "fontSize": "19.5dp",
                    "fontWeight": "600",
                    "color": "#0D7039"
                  }
                ]
              },

              {
                "type": "Container",
                "when": "${myPrayerTimeData.properties.isDhulHijjah}",
                "direction": "column",
                "alignItems": "center",
                "width": "100%",
                "spacing": "12.5dp",
                "items": [
                  {
                    "type": "Frame",
                    "when": "${myPrayerTimeData.properties.dhulHijjah.isFirstTenDays}",
                    "borderRadius": "20dp",
                    "backgroundColor": "rgba(216,182,95,0.15)",
                    "borderWidth": "2",
                    "borderColor": "#D8B65F",
                    "paddingLeft": "20dp",
                    "paddingRight": "20dp",
                    "paddingTop": "4dp",
                    "paddingBottom": "4dp",
                    "item": {
                      "type": "Container",
                      "direction": "row",
                      "alignItems": "center",
                      "items": [
                        {
                          "type": "Text",
                          "text": "🕋 ${myPrayerTimeData.properties.dhulHijjah.firstTenText}",
                          "fontSize": "19.5dp",
                          "fontWeight": "700",
                          "color": "#95773E"
                        },
                        {
                          "type": "Text",
                          "text": "  ·  Best 10 Days of the Year",
                          "fontSize": "19.5dp",
                          "color": "#50575C"
                        },
                        {
                          "type": "Text",
                          "when": "${myPrayerTimeData.properties.dhulHijjah.eidAdhaCountdown}",
                          "text": "  ·  ${myPrayerTimeData.properties.dhulHijjah.eidAdhaCountdown}",
                          "fontSize": "19.5dp",
                          "color": "#50575C"
                        }
                      ]
                    }
                  },

                  {
                    "type": "Frame",
                    "when": "${myPrayerTimeData.properties.dhulHijjah.hajjCountdown}",
                    "borderRadius": "16dp",
                    "backgroundColor": "rgba(13,112,57,0.1)",
                    "borderWidth": "2",
                    "borderColor": "#0D7039",
                    "paddingLeft": "16dp",
                    "paddingRight": "16dp",
                    "paddingTop": "4dp",
                    "paddingBottom": "4dp",
                    "item": {
                      "type": "Container",
                      "direction": "row",
                      "alignItems": "center",
                      "items": [
                        {
                          "type": "Text",
                          "text": "🕋 ${myPrayerTimeData.properties.dhulHijjah.hajjCountdown}",
                          "fontSize": "19.5dp",
                          "fontWeight": "700",
                          "color": "#0D7039"
                        }
                      ]
                    }
                  },

                  {
                    "type": "Frame",
                    "when": "${myPrayerTimeData.properties.dhulHijjah.isArafah}",
                    "borderRadius": "16dp",
                    "backgroundColor": "rgba(13,112,57,0.15)",
                    "borderWidth": "3",
                    "borderColor": "#0D7039",
                    "paddingLeft": "16dp",
                    "paddingRight": "16dp",
                    "paddingTop": "6dp",
                    "paddingBottom": "6dp",
                    "item": {
                      "type": "Container",
                      "direction": "row",
                      "alignItems": "center",
                      "items": [
                        {
                          "type": "Text",
                          "text": "🤲 Day of Arafah",
                          "fontSize": "19.5dp",
                          "fontWeight": "700",
                          "color": "#0D7039"
                        },
                        {
                          "type": "Text",
                          "text": "  ·  Fasting Highly Recommended",
                          "fontSize": "19.5dp",
                          "fontWeight": "600",
                          "color": "#95773E"
                        }
                      ]
                    }
                  },

                  {
                    "type": "Frame",
                    "when": "${myPrayerTimeData.properties.dhulHijjah.isEidAlAdha}",
                    "borderRadius": "16dp",
                    "backgroundColor": "rgba(216,182,95,0.25)",
                    "borderWidth": "3",
                    "borderColor": "#D8B65F",
                    "paddingLeft": "16dp",
                    "paddingRight": "16dp",
                    "paddingTop": "6dp",
                    "paddingBottom": "6dp",
                    "item": {
                      "type": "Container",
                      "direction": "row",
                      "alignItems": "center",
                      "items": [
                        {
                          "type": "Text",
                          "text": "🎉 Eid al-Adha Mubarak!",
                          "fontSize": "19.5dp",
                          "fontWeight": "700",
                          "color": "#95773E"
                        },
                        {
                          "type": "Text",
                          "text": "  ·  تقبّل الله منّا ومنكم",
                          "fontSize": "19.5dp",
                          "fontWeight": "600",
                          "color": "#95773E"
                        }
                      ]
                    }
                  },

                  {
                    "type": "Frame",
                    "when": "${myPrayerTimeData.properties.dhulHijjah.isTashreeq}",
                    "borderRadius": "16dp",
                    "backgroundColor": "rgba(13,112,57,0.1)",
                    "borderWidth": "1",
                    "borderColor": "rgba(13,112,57,0.3)",
                    "paddingLeft": "16dp",
                    "paddingRight": "16dp",
                    "paddingTop": "4dp",
                    "paddingBottom": "4dp",
                    "item": {
                      "type": "Container",
                      "direction": "row",
                      "alignItems": "center",
                      "items": [
                        {
                          "type": "Text",
                          "text": "📿 ${myPrayerTimeData.properties.dhulHijjah.bannerText}",
                          "fontSize": "19.5dp",
                          "fontWeight": "700",
                          "color": "#0D7039"
                        },
                        {
                          "type": "Text",
                          "text": "  ·  Takbeer after every prayer",
                          "fontSize": "19.5dp",
                          "color": "#50575C"
                        }
                      ]
                    }
                  }
                ]
              },

              {
                "type": "Container",
                "direction": "row",
                "justifyContent": "spaceBetween",
                "alignItems": "center",
                "width": "100%",
                "grow": 1,
                "items": [

                  {
                    "type": "Container",
                    "direction": "column",
                    "alignItems": "center",
                    "justifyContent": "center",
                    "grow": 1,
                    "items": [
                      {
                        "type": "Text",
                        "text": "${myPrayerTimeData.properties.currentTime}",
                        "fontSize": "104.5dp",
                        "fontWeight": "200",
                        "color": "#24332A",
                        "textAlign": "center",
                        "letterSpacing": "2dp"
                      },
                      {
                        "type": "Text",
                        "text": "${myPrayerTimeData.properties.gregorianDate}",
                        "fontSize": "26.5dp",
                        "color": "#50575C",
                        "textAlign": "center",
                        "spacing": "4dp"
                      }
                    ]
                  },

                  {
                    "type": "Container",
                    "direction": "column",
                    "alignItems": "center",
                    "justifyContent": "center",
                    "width": "24vw",
                    "paddingBottom": "5dp",
                    "items": [
                      {
                        "type": "Frame",
                        "width": "170dp",
                        "height": "170dp",
                        "borderRadius": "85dp",
                        "backgroundColor": "rgba(13,112,57,0.1)",
                        "borderWidth": "3",
                        "borderColor": "#0D7039",
                        "item": {
                          "type": "Container",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "direction": "column",
                          "width": "100%",
                          "height": "100%",
                          "items": [
                            {
                              "type": "Text",
                              "text": "${myPrayerTimeData.properties.nextPrayer.countdown}",
                              "fontSize": "38.5dp",
                              "fontWeight": "700",
                              "color": "#24332A"
                            },
                            {
                              "type": "Text",
                              "text": "━━━",
                              "fontSize": "20.5dp",
                              "color": "#D0D0D0"
                            },
                            {
                              "type": "Text",
                              "text": "${myPrayerTimeData.properties.nextPrayer.nameEn}",
                              "fontSize": "28.5dp",
                              "fontWeight": "700",
                              "color": "#0D7039"
                            }
                          ]
                        }
                      },
                      {
                        "type": "Text",
                        "text": "at ${myPrayerTimeData.properties.nextPrayer.time}",
                        "fontSize": "20.5dp",
                        "fontWeight": "600",
                        "color": "#0D7039",
                        "textAlign": "center",
                        "spacing": "8dp"
                      }
                    ]
                  }
                ]
              },

              {
                "type": "Container",
                "direction": "row",
                "justifyContent": "spaceEvenly",
                "alignItems": "stretch",
                "width": "100%",
                "height": "36vh",
                "items": [

                  {
                    "type": "Frame",
                    "grow": 1,
                    "borderRadius": "14dp",
                    "backgroundColor": "${myPrayerTimeData.properties.prayers[0].isNext ? 'rgba(13,112,57,0.12)' : '#F0F0F0'}",
                    "borderWidth": "${myPrayerTimeData.properties.prayers[0].isNext ? '2' : '1'}",
                    "borderColor": "${myPrayerTimeData.properties.prayers[0].isNext ? '#0D7039' : '#D0D0D0'}",
                    "marginRight": "6dp",
                    "item": {
                      "type": "Container",
                      "direction": "column",
                      "alignItems": "center",
                      "justifyContent": "center",
                      "width": "100%",
                      "height": "100%",
                      "items": [
                        { "type": "Text", "text": "🌅", "fontSize": "30dp" },
                        { "type": "Text", "text": "Fajr", "fontSize": "24dp", "fontWeight": "700", "color": "${myPrayerTimeData.properties.prayers[0].isNext ? '#0D7039' : '#24332A'}", "spacing": "4dp" },
                        { "type": "Text", "text": "${myPrayerTimeData.properties.prayers[0].time}", "fontSize": "26dp", "fontWeight": "700", "color": "${myPrayerTimeData.properties.prayers[0].isNext ? '#0D7039' : '#000000'}", "spacing": "4dp" },
                        { "type": "Text", "text": "Iqama", "fontSize": "15dp", "color": "#50575C", "spacing": "4dp" },
                        { "type": "Text", "text": "${myPrayerTimeData.properties.prayers[0].iqama}", "fontSize": "22dp", "fontWeight": "700", "color": "#0D7039", "spacing": "2dp" }
                      ]
                    }
                  },

                  {
                    "type": "Frame",
                    "grow": 1,
                    "borderRadius": "14dp",
                    "backgroundColor": "${myPrayerTimeData.properties.prayers[1].isNext ? 'rgba(13,112,57,0.12)' : '#F0F0F0'}",
                    "borderWidth": "${myPrayerTimeData.properties.prayers[1].isNext ? '2' : '1'}",
                    "borderColor": "${myPrayerTimeData.properties.prayers[1].isNext ? '#0D7039' : '#D0D0D0'}",
                    "marginRight": "6dp",
                    "item": {
                      "type": "Container",
                      "direction": "column",
                      "alignItems": "center",
                      "justifyContent": "center",
                      "width": "100%",
                      "height": "100%",
                      "items": [
                        { "type": "Text", "text": "☀️", "fontSize": "30dp" },
                        { "type": "Text", "text": "Dhuhr", "fontSize": "24dp", "fontWeight": "700", "color": "${myPrayerTimeData.properties.prayers[1].isNext ? '#0D7039' : '#24332A'}", "spacing": "4dp" },
                        { "type": "Text", "text": "${myPrayerTimeData.properties.prayers[1].time}", "fontSize": "26dp", "fontWeight": "700", "color": "${myPrayerTimeData.properties.prayers[1].isNext ? '#0D7039' : '#000000'}", "spacing": "4dp" },
                        { "type": "Text", "text": "Iqama", "fontSize": "15dp", "color": "#50575C", "spacing": "4dp" },
                        { "type": "Text", "text": "${myPrayerTimeData.properties.prayers[1].iqama}", "fontSize": "22dp", "fontWeight": "700", "color": "#0D7039", "spacing": "2dp" }
                      ]
                    }
                  },

                  {
                    "type": "Frame",
                    "grow": 1,
                    "borderRadius": "14dp",
                    "backgroundColor": "${myPrayerTimeData.properties.prayers[2].isNext ? 'rgba(13,112,57,0.12)' : '#F0F0F0'}",
                    "borderWidth": "${myPrayerTimeData.properties.prayers[2].isNext ? '2' : '1'}",
                    "borderColor": "${myPrayerTimeData.properties.prayers[2].isNext ? '#0D7039' : '#D0D0D0'}",
                    "marginRight": "6dp",
                    "item": {
                      "type": "Container",
                      "direction": "column",
                      "alignItems": "center",
                      "justifyContent": "center",
                      "width": "100%",
                      "height": "100%",
                      "items": [
                        { "type": "Text", "text": "🌤", "fontSize": "30dp" },
                        { "type": "Text", "text": "Asar", "fontSize": "24dp", "fontWeight": "700", "color": "${myPrayerTimeData.properties.prayers[2].isNext ? '#0D7039' : '#24332A'}", "spacing": "4dp" },
                        { "type": "Text", "text": "${myPrayerTimeData.properties.prayers[2].time}", "fontSize": "26dp", "fontWeight": "700", "color": "${myPrayerTimeData.properties.prayers[2].isNext ? '#0D7039' : '#000000'}", "spacing": "4dp" },
                        { "type": "Text", "text": "Iqama", "fontSize": "15dp", "color": "#50575C", "spacing": "4dp" },
                        { "type": "Text", "text": "${myPrayerTimeData.properties.prayers[2].iqama}", "fontSize": "22dp", "fontWeight": "700", "color": "#0D7039", "spacing": "2dp" }
                      ]
                    }
                  },

                  {
                    "type": "Frame",
                    "grow": 1,
                    "borderRadius": "14dp",
                    "backgroundColor": "${myPrayerTimeData.properties.prayers[3].isNext ? 'rgba(13,112,57,0.12)' : '#F0F0F0'}",
                    "borderWidth": "${myPrayerTimeData.properties.prayers[3].isNext ? '2' : '1'}",
                    "borderColor": "${myPrayerTimeData.properties.prayers[3].isNext ? '#0D7039' : '#D0D0D0'}",
                    "marginRight": "6dp",
                    "item": {
                      "type": "Container",
                      "direction": "column",
                      "alignItems": "center",
                      "justifyContent": "center",
                      "width": "100%",
                      "height": "100%",
                      "items": [
                        { "type": "Text", "text": "🌇", "fontSize": "30dp" },
                        { "type": "Text", "text": "Maghrib", "fontSize": "24dp", "fontWeight": "700", "color": "${myPrayerTimeData.properties.prayers[3].isNext ? '#0D7039' : '#24332A'}", "spacing": "4dp" },
